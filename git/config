[user]
	name = TheLeBerton
	email = theleberton@gmail.com

[core]
	compression = 9
	whitespace = error
	preloadindex = true
	pager = less

[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false

[url "git@github.com:TheLeBerton/"]
	insteadOf = "cj:"

[url "git@github.com"]
	insteadOf = "gh:"

[init]
	defaultBranch = master

[status]
	branch = true
	showStash = true
	showUntrackedFiles = all

[diff]
	tool = nvim_difftool

[difftool "nvim_difftool"]
	cmd = nvim -c \"packadd nvim.difftool\" -c \"DiffTool $LOCAL $REMOTE\"

[pager]
	diff = diff-so-fancy | less --tabs=4 -RF

[diff-so-fancy]
	markEmptyLines = false

[interactive]
	diffFilter = diff-so-fancy --patch
	singlekey = true

[log]
	abbrevCommit = true
	graphColors = blue,yellow,cyan,magenta,green,red

[color "decorate"]
	HEAD = red
	branch = blue
	tag = yellow
	remoteBranch = magenta

[color "branch"]
	current = magenta
	local = default
	remote = yellow
	upstream = green
	plain = blue

[branch]
	sort = -committerdate

[tag]
	sort = -taggerdate

[commit]
	template = ~/.dotfiles/git/.gitmessage.txt
