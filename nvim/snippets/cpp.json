{
	"Orthodox canonical class (hpp)": {
		"prefix": "classhpp",
		"body": [
			"#ifndef ${1:$TM_FILENAME_BASE}_HPP",
			"#define $1_HPP",
			"",
			"class ${2:$TM_FILENAME_BASE} {",
			"public:",
			"\t$2();",
			"\t$2(const $2 &other);",
			"\t$2 &operator=(const $2 &other);",
			"\t~$2();",
			"",
			"private:",
			"\t$0",
			"};",
			"",
			"#endif"
		]
	},
	"Orthodox canonical class (cpp)": {
		"prefix": "classcpp",
		"body": [
			"#include \"${1:$TM_FILENAME_BASE}.hpp\"",
			"",
			"$1::$1 () {",
			"}",
			"",
			"$1::$1 (const $1& other) {",
			"}",
			"",
			"$1& $1::operator= (const $1& other) {",
			"\tif (this != &other) {",
			"\t}",
			"\treturn *this;",
			"}",
			"",
			"$1::~$1 () {",
			"}"
		]
	}
}
